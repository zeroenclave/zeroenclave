            "value" : "Ce que voit le cloud"
          }
        }
      }
    },
    "When off, photos in this album are hidden from All Photos. They stay visible in the album." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist das aus, sind die Fotos dieses Albums in „Alle Fotos“ ausgeblendet. Im Album bleiben sie sichtbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si está desactivado, las fotos de este álbum se ocultan en «Todas las fotos». En el álbum siguen visibles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est désactivée, les photos de cet album sont masquées dans « Toutes les photos ». Elles restent visibles dans l’album."
          }
        }
      }
    },
    "Why a strong password?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warum ein starkes Passwort?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Por qué una contraseña segura?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pourquoi un mot de passe robuste ?"
          }
        }
      }
    },
    "Wipes the vault if you are forced to unlock it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht den Tresor, wenn du zum Entsperren gezwungen wirst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra la bóveda si te obligan a desbloquearla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface le coffre-fort si l’on vous force à le déverrouiller."
          }
        }
      }
    },
    "Wipes the vault under pressure." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht den Tresor unter Druck."
          }
