            "value" : "Le mot de passe principal est incorrect."
          }
        }
      }
    },
    "Wrong password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falsches Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contraseña incorrecta."
          }
        },
        "fr" : {
