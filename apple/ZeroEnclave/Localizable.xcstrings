    "View, restore and delete items in the Trash with Premium. Items are deleted permanently after 30 days." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Premium kannst du den Papierkorb ansehen, Objekte wiederherstellen und endgültig löschen. Nach 30 Tagen wird automatisch gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
