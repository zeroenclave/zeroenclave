            "value" : "Auf dem Sperrbildschirm eingegeben, löscht es den Tresor auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se introduce en la pantalla de desbloqueo, destruye la bóveda en este dispositivo."
