    "iOS has locked Face ID after too many attempts. Lock the device and unlock it with your passcode, then Face ID works again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS hat Face ID nach zu vielen Versuchen gesperrt. Sperre das Gerät und entsperre es mit dem Code, dann funktioniert Face ID wieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ha bloqueado Face ID tras demasiados intentos. Bloquea el dispositivo y desbloquéalo con tu código; después, Face ID volverá a funcionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS a verrouillé Face ID après trop de tentatives. Verrouillez l’appareil et déverrouillez-le avec votre code d’accès ; Face ID fonctionnera ensuite à nouveau."
          }
        }
      }
    }
