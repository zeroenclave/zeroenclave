    },
    "The vault could not be verified. Its data may be damaged or changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tresor konnte nicht überprüft werden. Seine Daten sind möglicherweise beschädigt oder verändert."
          }
        },
        "es" : {
          "stringUnit" : {
