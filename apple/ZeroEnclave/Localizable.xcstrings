        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bóveda está bloqueada o en solo lectura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le coffre-fort est verrouillé ou en lecture seule."
          }
        }
      }
    },
    "The vault locks automatically when you leave the app or stop using it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tresor wird automatisch gesperrt, wenn du die App verlässt oder nicht mehr nutzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bóveda se bloquea automáticamente cuando sales de la app o dejas de usarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le coffre-fort se verrouille automatiquement lorsque vous quittez l’app ou cessez de l’utiliser."
          }
        }
      }
    },
    "The vault on this device is destroyed and an empty vault opens that looks like a new one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tresor auf deinem Gerät wird zerstört und ein leerer Tresor öffnet sich, der wie ein neuer aussieht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bóveda de este dispositivo se destruye y se abre una bóveda vacía que parece nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le coffre-fort de cet appareil est détruit et un coffre-fort vide, qui semble neuf, s’ouvre."
          }
        }
      }
    },
    "The vault opens only with the master password or the recovery key." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tresor öffnet sich nur mit dem Master-Passwort oder dem Wiederherstellungsschlüssel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La bóveda solo se abre con la contraseña maestra o la clave de recuperación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le coffre-fort ne s’ouvre qu’avec le mot de passe principal ou la clé de secours."
          }
        }
      }
    },
    "The whole vault in one encrypted file." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der ganze Tresor in einer verschlüsselten Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toda la bóveda en un único archivo cifrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le coffre-fort dans un seul fichier chiffré."
          }
        }
      }
    },
    "Themes & icons" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Themes und Icons"
          }
        },
        "es" : {
          "stringUnit" : {
