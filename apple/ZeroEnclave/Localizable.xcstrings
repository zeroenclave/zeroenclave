    "Each device opens the vault with your master password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Gerät öffnet den Tresor mit deinem Master-Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada dispositivo abre la bóveda con tu contraseña maestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque appareil ouvre le coffre-fort avec votre mot de passe principal."
          }
        }
      }
    },
    "Each file has its own random key and is encrypted in 1 MiB segments. Modification, reordering and truncation are detected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Datei hat einen eigenen Zufallsschlüssel und wird in Segmenten zu 1 MiB verschlüsselt. Änderungen, Vertauschen und Abschneiden werden erkannt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada archivo tiene su propia clave aleatoria y se cifra en segmentos de 1 MiB. Se detectan modificaciones, reordenaciones y truncamientos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque fichier a sa propre clé aléatoire et est chiffré par segments de 1 MiB. Les modifications, les changements d’ordre et les troncatures sont détectés."
          }
        }
      }
    },
