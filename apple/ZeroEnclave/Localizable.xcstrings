    "After a wrong PIN, Zero Enclave asks for the master password once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach einer falschen PIN fragt Zero Enclave einmal nach dem Master-Passwort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras un PIN incorrecto, Zero Enclave pide una vez la contraseña maestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après un code PIN erroné, Zero Enclave demande une fois le mot de passe principal."
          }
        }
      }
    },
    "Afterwards this password is the master password of the empty vault. Create a new recovery key in Security." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danach ist dieses Passwort das Master-Passwort des leeren Tresors. Erstelle unter Sicherheit einen neuen Wiederherstellungsschlüssel."
