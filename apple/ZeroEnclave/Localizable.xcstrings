            "state" : "translated",
            "value" : "Tipp: Vier oder fünf zufällige Wörter sind stark und leicht zu merken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consejo: cuatro o cinco palabras al azar son seguras y fáciles de recordar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Astuce : quatre ou cinq mots aléatoires sont robustes et faciles à retenir."
