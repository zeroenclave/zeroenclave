          }
        }
      }
    },
    "This backup is from another vault. You can only restore it in place of this vault." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Backup stammt von einem anderen Tresor. Du kannst es nur anstelle dieses Tresors wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de seguridad es de otra bóveda. Solo puedes restaurarla en lugar de esta bóveda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette sauvegarde provient d’un autre coffre-fort. Vous ne pouvez la restaurer qu’à la place de ce coffre-fort."
          }
        }
      }
    },
    "This cannot be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kann nicht rückgängig gemacht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action est irréversible."
          }
        }
      }
    },
    "This password cannot be reset. Without it and the recovery key, the data is lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Passwort lässt sich nicht zurücksetzen. Ohne Passwort und Wiederherstellungsschlüssel sind die Daten verloren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta contraseña no se puede restablecer. Sin ella y sin la clave de recuperación, los datos se pierden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mot de passe ne peut pas être réinitialisé. Sans lui ni la clé de secours, les données sont perdues."
          }
        }
      }
    },
    "This recovery key is not valid. Check it for typing mistakes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Wiederherstellungsschlüssel ist ungültig. Prüfe ihn auf Tippfehler."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta clave de recuperación no es válida. Comprueba si tiene errores de escritura."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette clé de secours n’est pas valide. Vérifiez qu’elle ne contient pas de faute de frappe."
          }
        }
      }
    },
    "This turns off the panic password, Face ID and PIN. Older backups still open with the old password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden Panik-Passwort, Face ID und PIN ausgeschaltet. Ältere Backups lassen sich weiterhin mit dem alten Passwort öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto desactiva la contraseña de pánico, Face ID y el PIN. Las copias de seguridad anteriores se siguen abriendo con la contraseña anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela désactive le mot de passe de panique, Face ID et le code PIN. Les sauvegardes plus anciennes s’ouvrent toujours avec l’ancien mot de passe."
          }
        }
      }
    },
    "Thumbnails and albums" : {
      "localizations" : {
        "de" : {
