            "value" : "Mot de passe incorrect."
          }
        }
      }
    },
    "You choose a four-digit code on the next page." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf der nächsten Seite legst du einen vierstelligen Code fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la página siguiente eliges un código de cuatro dígitos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À la page suivante, vous choisissez un code à quatre chiffres."
          }
        }
      }
    },
    "You set a second password, different from your master password." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du legst ein zweites Passwort fest, das sich von deinem Master-Passwort unterscheidet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estableces una segunda contraseña, distinta de tu contraseña maestra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous définissez un second mot de passe, différent de votre mot de passe principal."
          }
        }
      }
    },
    "Your master password confirms the change." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Master-Passwort bestätigt die Änderung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña maestra confirma el cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe principal confirme la modification."
          }
        }
      }
    },
    "Your password stays here" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Passwort bleibt hier"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu contraseña se queda aquí"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre mot de passe reste ici"
          }
        }
      }
    },
    "Your photos stay as they are. Only the password changes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Fotos bleiben, wie sie sind. Nur das Passwort ändert sich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus fotos se quedan como están. Solo cambia la contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos photos restent telles quelles. Seul le mot de passe change."
          }
        }
      }
    },
    "Your recovery key" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Wiederherstellungsschlüssel"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave de recuperación"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé de secours"
          }
        }
      }
    },
    "Your recovery key becomes useless once the vault is destroyed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Wiederherstellungsschlüssel ist nutzlos, sobald der Tresor zerstört ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave de recuperación deja de servir cuando se destruye la bóveda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé de secours devient inutile une fois le coffre-fort détruit."
          }
        }
      }
    },
    "Your vault is ready" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Tresor ist bereit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bóveda está lista"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre coffre-fort est prêt"
          }
        }
      }
    },
    "Your vault stays on your device. The app has no network access." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Tresor bleibt auf deinem Gerät. Die App hat keinen Netzwerkzugriff."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu bóveda permanece en tu dispositivo. La app no tiene acceso a la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre coffre-fort reste sur votre appareil. L’app n’a pas accès au réseau."
          }
        }
      }
    },
    "Zero Enclave" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave"
          }
        }
      }
    },
    "Zero Enclave Premium" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave Premium"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave Premium"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave Premium"
          }
        }
      }
    },
    "Zero Enclave encrypts everything on your device before it is uploaded. In the cloud, your vault is encrypted exactly as it is on your device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave verschlüsselt alles auf deinem Gerät, bevor es hochgeladen wird. In der Cloud ist dein Tresor genauso verschlüsselt wie auf deinem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave lo cifra todo en tu dispositivo antes de subirlo. En la nube, tu bóveda está cifrada exactamente igual que en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave chiffre tout sur votre appareil avant l’envoi. Dans le cloud, votre coffre-fort est chiffré exactement comme sur votre appareil."
          }
        }
      }
    },
    "Zero Enclave found vault files on this device that differ from what it recorded. Older files may have been put back, for example from a copy." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave hat auf diesem Gerät Tresor-Dateien gefunden, die nicht zum gespeicherten Stand passen. Möglicherweise wurden ältere Dateien zurückgespielt, zum Beispiel aus einer Kopie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave ha encontrado archivos de la bóveda en este dispositivo que no coinciden con lo que tenía registrado. Puede que se hayan restaurado archivos anteriores, por ejemplo desde una copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave a trouvé sur cet appareil des fichiers du coffre-fort qui ne correspondent pas à ce qu’il avait enregistré. Des fichiers plus anciens ont peut-être été restaurés, par exemple depuis une copie."
          }
        }
      }
    },
    "Zero Enclave locks the vault immediately when you leave the app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave sperrt den Tresor sofort, wenn du die App verlässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave bloquea la bóveda en cuanto sales de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave verrouille le coffre-fort dès que vous quittez l’app."
          }
        }
      }
    },
    "Zero Enclave makes no network connections. Data leaves your device only through an export." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave baut keine Netzwerkverbindungen auf. Daten verlassen dein Gerät nur über einen Export."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave no establece conexiones de red. Los datos solo salen de tu dispositivo mediante una exportación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zero Enclave n’établit aucune connexion réseau. Les données ne quittent votre appareil que par une exportation."
          }
        }
      }
    },
