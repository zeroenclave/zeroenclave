    "A copy of the vault, for example a backup, can be attacked offline with unlimited attempts. A long password makes this impractical." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Kopie des Tresors, etwa ein Backup, kann offline mit beliebig vielen Versuchen angegriffen werden. Ein langes Passwort macht das praktisch unmöglich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia de la bóveda, por ejemplo una copia de seguridad, puede atacarse sin conexión con intentos ilimitados. Una contraseña larga lo hace inviable en la práctica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une copie du coffre-fort, par exemple une sauvegarde, peut être attaquée hors ligne avec un nombre illimité de tentatives. Un mot de passe long rend cela impraticable."
          }
        }
      }
    },
    "A new recovery key replaces the old one. The old key stops working." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neuer Wiederherstellungsschlüssel ersetzt den alten. Der alte Schlüssel funktioniert dann nicht mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nueva clave de recuperación sustituye a la anterior. La clave anterior deja de funcionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une nouvelle clé de secours remplace l’ancienne. L’ancienne clé ne fonctionne plus."
          }
        }
      }
    },
    "A private vault for your photos and videos." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein privater Tresor für deine Fotos und Videos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una bóveda privada para tus fotos y vídeos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un coffre-fort privé pour vos photos et vidéos."
          }
        }
      }
    },
    "A second password that destroys your vault." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein zweites Passwort, das deinen Tresor zerstört."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una segunda contraseña que destruye tu bóveda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un second mot de passe qui détruit votre coffre-fort."
          }
        }
      }
    },
